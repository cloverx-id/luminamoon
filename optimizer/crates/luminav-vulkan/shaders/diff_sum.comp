#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer FloatBuffer {
    float data[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) buffer RawU32BufferRef {
    uint data[];
};

layout(push_constant) uniform PushConstants {
    uint64_t grad_ptr;
    uint64_t exp_avg_ptr;
    uint64_t scratch_ptr;
    uint n_elements;
} push;

shared float s_subgroup_sums[32];

void atomicAddFloat(RawU32BufferRef buf, uint word_idx, float val) {
    uint old_val = buf.data[word_idx];
    while (true) {
        float cur_f = uintBitsToFloat(old_val);
        float new_f = cur_f + val;
        uint new_val = floatBitsToUint(new_f);
        uint prev = atomicCompSwap(buf.data[word_idx], old_val, new_val);
        if (prev == old_val) {
            break;
        }
        old_val = prev;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    float diff = 0.0;

    if (idx < push.n_elements) {
        FloatBuffer grad_buf = FloatBuffer(push.grad_ptr);
        FloatBuffer exp_avg_buf = FloatBuffer(push.exp_avg_ptr);

        float g = grad_buf.data[idx];
        if (isnan(g) || isinf(g) || abs(g) >= 1.0e38) {
            g = 0.0;
        } else {
            g = clamp(g, -1.0e18, 1.0e18);
        }
        float m = exp_avg_buf.data[idx];
        diff = clamp(g - m, -1.0e18, 1.0e18);
    }

    float wave_sum = subgroupAdd(diff);

    uint subgroup_id = gl_SubgroupID;
    if (subgroupElect() && subgroup_id < 32u) {
        s_subgroup_sums[subgroup_id] = wave_sum;
    }

    barrier();
    memoryBarrierShared();

    if (gl_LocalInvocationID.x == 0u) {
        float wg_sum = 0.0;
        uint num_subgroups = min(gl_NumSubgroups, 32u);
        for (uint i = 0u; i < num_subgroups; ++i) {
            wg_sum += s_subgroup_sums[i];
        }
        RawU32BufferRef scratch_buf = RawU32BufferRef(push.scratch_ptr);
        atomicAddFloat(scratch_buf, 5u, wg_sum);
    }
}
